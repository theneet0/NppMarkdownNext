            const sw = parseFloat(st.strokeWidth || '1');
            const ops = segsToOps(segs, m);
            if (!ops.length) return;
            const doFill = fill && st.fill !== 'none';
            const doStroke = stroke && sw > 0 && st.strokeExplicit;
            if (!doFill && !doStroke) return;
            if (doFill) paint(null, st, fill, false);
            if (doStroke) {
