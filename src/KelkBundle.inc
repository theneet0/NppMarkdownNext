        }

        // ── tables ───────────────────────────────────────────────────────────

        /**
         * Width of content tables: 'auto' (default) — as wide as the content
         * wants, up to 100% — or a share of the text width ('98%', '75%' …). Column widths follow the content in every case (the same shares
         * in all four outputs).
