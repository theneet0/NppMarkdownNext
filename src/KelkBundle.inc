                    continue;
                }
                if (tag === 'line') {
                    const ls = Object.assign({}, s, { fill: 'none', strokeExplicit: true, stroke: s.stroke || 'currentColor' });
                    shape([['M', +c.getAttribute('x1') || 0, +c.getAttribute('y1') || 0], ['L', +c.getAttribute('x2') || 0, +c.getAttribute('y2') || 0]], cm, ls);
