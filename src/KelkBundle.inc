            //           →  Mso classes
            //           →  BiDi runs
            let bodyHtml;
            if (typeof document !== 'undefined') {
                const root = BidiCore.inertRoot();          // parsed without loading images
                root.innerHTML = this._contentHtml;
                BidiCore.unwrapCodeBlocks(root);      // preview decoration out, first
                // task-list checkboxes → ☐ ☑ (a live <input> is a form control Word warns about)
                root.querySelectorAll('input[type=checkbox], input[type="checkbox"]').forEach(function (inp) {
                    inp.parentNode.replaceChild(root.ownerDocument.createTextNode(this._taskMark(inp) + ' '), inp);
                }, this);
                root.querySelectorAll('.kelk-math[data-tex]').forEach(function (el) {   // toHtml() is sync: formulas as TeX
