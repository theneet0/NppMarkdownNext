                if (tag === 'rect') {
                    if (c.hasAttribute('data-background')) continue;       // error highlight — errors are not drawn as formulas
                    const rw = parseFloat(c.getAttribute('width')) || 0, rh = parseFloat(c.getAttribute('height')) || 0;
                    if (rw <= 0 || rh <= 0) continue;
