            });
            const cells = new Map();
            trs.forEach(function (tr, i) {
                Array.from(tr.cells).forEach(function (cell) {
                    const c0 = cols.get(cell), span = Math.max(1, cell.colSpan || 1);
                    const below = Math.min(rs.length, i + Math.max(1, cell.rowSpan || 1));
                    cells.set(cell, {
