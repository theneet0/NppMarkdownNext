            const doc = new JsPDF({
                unit: 'pt', format: [Math.min(pageW, pageH), Math.max(pageW, pageH)],
                orientation: landscape ? 'landscape' : 'portrait',
                compress: cfg.pdf.compress !== false, putOnlyUsedFonts: true
