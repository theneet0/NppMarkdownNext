  .settings > .rail .rail-chev { display: block; margin-inline-start: auto; }
  .settings .wide-only { display: none; }
  .settings .narrow-only { display: inline-flex; }
  .settings > .pane-head { cursor: pointer; }
  .settings > .pane-head:hover h2 { color: var(--accent-ink); }
}
@media (max-width: 760px) { .editor-panel .pane-toggle { display: none; } }

.settings .pane-body { overflow: auto; padding: 6px 12px 14px; }

.group { border-bottom: 1px solid var(--line); }
.group:last-child { border-bottom: 0; }
.group > summary {
  list-style: none; cursor: pointer; padding: 10px 2px;
  display: flex; align-items: center; gap: 8px; font-weight: 600;
}
.group > summary::-webkit-details-marker { display: none; }
.group > summary::after {
  content: ''; margin-inline-start: auto; width: 8px; height: 8px;
  border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted);   /* physical: a down chevron in both directions */
  transform: rotate(45deg); transition: transform .15s;
}
.group[open] > summary::after { transform: rotate(-135deg); }
.group > summary svg { width: 16px; height: 16px; color: var(--accent); }
.group .fields { display: grid; gap: 10px; padding: 2px 2px 14px; }

.field { display: grid; gap: 4px; }
.field > span { font-size: 12.5px; color: var(--muted); }
.field input[type="text"], .field input[type="email"], .field input[type="url"], .field input[type="number"],
.field select, .field textarea {
  width: 100%;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-sm);
  background: var(--panel-2);
  padding: 6px 9px;
  min-height: 32px;
}
.field textarea { font-family: var(--font-mono); font-size: 12px; min-height: 110px; direction: ltr; text-align: left; resize: vertical; }
.field .hint { font-size: 11.5px; color: var(--muted); }
.field .hint.warn { color: var(--warn); }
.field input.auto { color: var(--muted); font-style: italic; }      /* an automatic value (edition) */
.label-row { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); }
.mini {
  display: inline-grid; place-items: center; width: 20px; height: 20px; padding: 0; border: 0; border-radius: 4px;
  background: transparent; color: var(--muted); cursor: pointer;
}
.mini:hover { background: var(--accent-soft); color: var(--accent-ink); }
.mini svg { width: 13px; height: 13px; }
.sub-head { font-size: 12px; font-weight: 700; color: var(--accent-ink); padding-top: 4px; border-top: 1px dashed var(--line); }
.fields > .sub-head:first-child { border-top: 0; padding-top: 0; }
.sub-head:empty { padding-top: 0; }
.btn-row { display: flex; gap: 6px; flex-wrap: wrap; }
.field .hint code { font-family: var(--font-mono); font-size: 11px; background: var(--code-bg); padding: 0 4px; border-radius: 4px; }
.row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
/* side by side, a label that wraps to two lines must not stretch its neighbour's control:
   each field keeps its natural height, the controls on one line at the bottom */
.row2 > .field, .row3 > .field { align-content: end; }
.row3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
/* color pickers (table style): a swatch the width of its column */
.field.color input[type="color"] {
  width: 100%; height: 32px; padding: 3px; cursor: pointer;
  border: 1px solid var(--line-strong); border-radius: var(--radius-sm); background: var(--panel-2);
}
.field.color input[type="color"]::-webkit-color-swatch-wrapper { padding: 0; }
.field.color input[type="color"]::-webkit-color-swatch { border: 0; border-radius: 3px; }
.field.color input[type="color"]::-moz-color-swatch { border: 0; border-radius: 3px; }
/* a color the chosen preset does not use */
.field.color.unused { opacity: .45; }
.field.color.unused input { cursor: not-allowed; }
.field.unused { opacity: .45; }
.field.unused select { cursor: not-allowed; }

.check { display: flex; align-items: center; gap: 8px; cursor: pointer; }
.check input { accent-color: var(--accent); width: 16px; height: 16px; flex: none; margin: 0; }   /* one size, also beside a two-line label */

.logo-box {
  display: flex; align-items: center; gap: 10px;
  border: 1px dashed var(--line-strong); border-radius: var(--radius-sm); padding: 8px;
}
.logo-box.dragging { border-color: var(--accent); background: var(--accent-soft); }
/* the logo sits on "paper" (white) in both themes, as in the exports */
.logo-box .thumb {
  width: 120px; height: 60px; flex: none; display: grid; place-items: center; padding: 4px;
  background: #fff; border: 1px solid var(--line); border-radius: 4px; color: #9a958c; font-size: 11px; overflow: hidden;
}
.logo-box .thumb img { width: 100%; height: 100%; object-fit: contain; display: block; }
.logo-box .btns { display: flex; gap: 6px; flex-wrap: wrap; }

/* ── toast ───────────────────────────────────────────────────────────── */
.toasts { position: fixed; inset-block-end: 18px; inset-inline-start: 50%; transform: translateX(-50%); display: grid; gap: 8px; z-index: 50; }
[dir="rtl"] .toasts { transform: translateX(50%); }
.toast {
  background: var(--toast-bg); color: var(--toast-ink);
  padding: 9px 14px; border-radius: var(--radius-sm); box-shadow: var(--shadow);
  font-size: 13px; max-width: 520px;
}
.toast.error { background: var(--danger); color: #fff; }
.toast { display: flex; align-items: center; gap: 12px; }
.toast-action {
  border: 0; background: none; padding: 2px 4px; color: inherit; font: inherit; font-weight: 700;
  text-decoration: underline; text-underline-offset: 3px; cursor: pointer; flex: none;
}
.toast.warn { background: var(--warn); color: #fff; }

/* ── to the page's top / end (only when the page itself scrolls) ─────── */
.page-jump {
  position: fixed; inset-inline-end: 14px; bottom: 16px; z-index: 45;
  display: flex; flex-direction: column; gap: 6px;
}
.page-jump .btn {
  width: 38px; height: 38px; border-radius: 50%; padding: 0; justify-content: center;
  background: color-mix(in srgb, var(--panel) 72%, transparent); box-shadow: var(--shadow); border-color: var(--line-strong);
  -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px);
  opacity: .78; transition: opacity .15s, visibility .15s;
}
.page-jump .btn:hover, .page-jump .btn:focus-visible { opacity: 1; background: var(--panel); }   /* solid under the pointer */
.page-jump .btn.off { opacity: 0; visibility: hidden; }
.page-jump .btn svg { width: 18px; height: 18px; }

/* ── dialog ──────────────────────────────────────────────────────────── */
dialog {
  border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); color: var(--ink);
  box-shadow: var(--shadow); padding: 0; width: min(560px, 92vw);
}
dialog::backdrop { background: rgba(0, 0, 0, .35); }
[data-theme="dark"] dialog::backdrop { background: rgba(0, 0, 0, .6); }
dialog .dlg-head { display: flex; align-items: center; padding: 12px 14px; border-bottom: 1px solid var(--line); }
dialog .dlg-head h2 { margin: 0; font-size: 15px; }
dialog .dlg-head .btn { margin-inline-start: auto; }
dialog .dlg-body { padding: 12px 14px 16px; }
dialog .dlg-body.fields { display: grid; gap: 10px; }
dialog table { width: 100%; border-collapse: collapse; font-size: 13px; }
dialog .dlg-head h2 { display: flex; align-items: center; gap: 8px; }
dialog .dlg-head h2 svg { width: 18px; height: 18px; color: var(--accent); }
/* the help: a short guide */
dialog.guide { width: min(620px, 94vw); }
.guide-intro { margin: 0 0 10px; }
.guide-steps { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
.guide-steps li { display: flex; gap: 10px; align-items: flex-start; }
.guide-steps li > svg { width: 18px; height: 18px; flex: none; margin-top: 3px; color: var(--accent); }
.guide-steps b { display: block; font-size: 13.5px; }
.guide-steps span { color: var(--muted); font-size: 13px; }
.guide-more { margin: 14px 0 10px; padding-top: 10px; border-top: 1px solid var(--line); font-size: 13px; }
dialog td { padding: 6px 4px; border-bottom: 1px solid var(--line); }
kbd {
  font-family: var(--font-mono); font-size: 11.5px;
  border: 1px solid var(--line-strong); border-bottom-width: 2px; border-radius: 4px; padding: 0 5px; background: var(--panel-2);
}

/* language switch: the other interface languages, each named in its own language */
.lang-switch { display: inline-flex; align-items: center; gap: 2px; color: var(--muted); }
.lang-switch svg { width: 16px; height: 16px; margin-inline-end: 2px; }
.lang-switch .btn { padding: 0 8px; }

/* the App group: last in Settings — only its heading is tinted (the app's own behavior, not the document's) */
details.group.app-group { margin-top: 14px; }
/* the tint reaches 6px beyond the text column on both sides, so icon and chevron stay in line with the other groups */
details.group.app-group > summary { color: var(--accent-ink); background: var(--accent-soft); border-radius: var(--radius-sm); margin-inline: -6px; padding-inline: 8px; }

/* a link inside a hint that opens another Settings group (Text → Word) */
.link-btn { border: 0; background: none; padding: 0; font: inherit; color: var(--accent-ink); text-decoration: underline; text-underline-offset: 2px; cursor: pointer; }
.link-btn:hover { color: var(--accent); }
[dir="rtl"] svg.rtl-mirror { transform: scaleX(-1); }
/* Settings: its open/close button in the column of the groups' chevrons (their centers 20px from
   the panel's edge: body padding 12 + summary 2 + half the chevron) — the head's padding is 12px, 10px on phones */
.settings > .pane-head #pane-close { margin-inline-end: -8px; }
@media (max-width: 600px) { .settings > .pane-head #pane-close { margin-inline-end: -6px; } }
.font-pack a.btn { text-decoration: none; color: var(--accent-ink); }


/* === preview.css === */
/* Kelk — the preview pane.
   The document's own look comes from HtmlBuilder's stylesheet (lib/PreviewBuilder → <style id="kelk-doc-css">),
   the same one the .html export embeds. This file adds only what belongs to the pane: spacing, the
   empty hint, the copy buttons, the source view, and the dark theme of the app. */

.doc {
  padding: 18px 22px 28px;
  color: var(--ink);
  overflow-wrap: anywhere;
}
.doc:empty::before { content: attr(data-empty); color: var(--placeholder); font-family: var(--font-ui); }
.doc > :first-child { margin-top: 0; }

/* wide tables scroll inside the pane */
.doc table:not(.kelk-fit) { display: block; overflow-x: auto; }

/* code frame bar: the language on one side, the copy button on the other */
.doc .code-lang { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 1.6em; }
.code-copy-btn {
  display: inline-flex; align-items: center; gap: 4px; border: 0; background: transparent; color: inherit; cursor: pointer;
  font-size: 12px; padding: 1px 6px; border-radius: 4px; font-family: var(--font-ui); margin-inline-start: auto;
}
.code-copy-btn:hover { background: var(--accent-soft); color: var(--accent-ink); }
.code-copy-btn svg { width: 14px; height: 14px; }
.code-copy-btn.copied { color: var(--accent); }
.doc .code-nested { position: relative; }
.code-nested-copy { position: absolute; top: 2px; right: 4px; padding: 1px 3px; opacity: .55; }
.code-nested:hover > .code-nested-copy { opacity: 1; }

/* Markdown shown as source (reverse view) */
.doc.source { font-family: var(--font-mono); font-size: 13px; white-space: pre-wrap; direction: ltr; text-align: left; unicode-bidi: plaintext; }

/* dark theme of the app. The document's own colors (tables, code, quotes, ToC) are translated
   for the dark page by scripts/preview.js (darkPaper) — the exports keep the chosen colors; here,
   only what the document stylesheet does not color: text on the page, code text and syntax colors. */
[data-theme="dark"] .doc h1, [data-theme="dark"] .doc h2, [data-theme="dark"] .doc h3,
[data-theme="dark"] .doc h4, [data-theme="dark"] .doc h5, [data-theme="dark"] .doc h6 { color: var(--accent-ink); }
[data-theme="dark"] .doc :not(pre) > code { background: var(--code-bg); color: var(--ink); }
[data-theme="dark"] .doc a { color: var(--accent-ink); }
[data-theme="dark"] .doc .code, [data-theme="dark"] .doc .code code.hljs { color: var(--ink); }
/* syntax colors for a dark box (GitHub dark) */
[data-theme="dark"] .doc .code .hljs-keyword, [data-theme="dark"] .doc .code .hljs-doctag, [data-theme="dark"] .doc .code .hljs-type,
[data-theme="dark"] .doc .code .hljs-meta .hljs-keyword, [data-theme="dark"] .doc .code .hljs-template-tag { color: #ff7b72; }
[data-theme="dark"] .doc .code .hljs-string, [data-theme="dark"] .doc .code .hljs-regexp, [data-theme="dark"] .doc .code .hljs-meta .hljs-string { color: #a5d6ff; }
[data-theme="dark"] .doc .code .hljs-title, [data-theme="dark"] .doc .code .hljs-title.function_, [data-theme="dark"] .doc .code .hljs-title.class_ { color: #d2a8ff; }
[data-theme="dark"] .doc .code .hljs-number, [data-theme="dark"] .doc .code .hljs-literal, [data-theme="dark"] .doc .code .hljs-attr,
[data-theme="dark"] .doc .code .hljs-attribute, [data-theme="dark"] .doc .code .hljs-variable, [data-theme="dark"] .doc .code .hljs-built_in,
[data-theme="dark"] .doc .code .hljs-selector-class, [data-theme="dark"] .doc .code .hljs-operator { color: #79c0ff; }
[data-theme="dark"] .doc .code .hljs-comment, [data-theme="dark"] .doc .code .hljs-quote { color: #8b949e; }
[data-theme="dark"] .doc .code .hljs-name, [data-theme="dark"] .doc .code .hljs-selector-tag, [data-theme="dark"] .doc .code .hljs-section { color: #7ee787; }
[data-theme="dark"] .doc .code .hljs-subst, [data-theme="dark"] .doc .code .hljs-params { color: var(--ink); }

/* highlight.js's page theme adds padding and a background to code.hljs: the frame has its own */
.doc pre code.hljs { padding: 0; background: none; }

