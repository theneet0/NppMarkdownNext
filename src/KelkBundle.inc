        // Header / Footer
        // =====================================================================

        // =====================================================================
        // Content
        // =====================================================================

        /** Append a page break to the content. */
        addPageBreak() {
            this._contentHtml += '<div style="page-break-before:always"></div>';
            return this;
        }

        /** Append a data-URI image (PNG/JPEG); options.width in pt (default: natural, max text width). */
        addImage(dataUri, options = {}) {
