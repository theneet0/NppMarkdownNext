         * the first pass finds the page of every listed heading, the second
         * prints the same layout with those page numbers.
         * @returns {object} jsPDF document
         */
        build() {
            if (!this._config.toc) return this._buildOnce();
            this._tocPages = null;
            this._tocCollect = {};
