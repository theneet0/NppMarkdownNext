                if (c.hasAttribute('stroke')) { s.stroke = c.getAttribute('stroke'); s.strokeExplicit = true; }
                if (c.hasAttribute('stroke-width')) s.strokeWidth = c.getAttribute('stroke-width');
                if (c.hasAttribute('stroke-dasharray')) s.dash = c.getAttribute('stroke-dasharray');
                if (c.hasAttribute('stroke-linecap')) s.linecap = c.getAttribute('stroke-linecap');
                if (c.hasAttribute('color')) s.color = c.getAttribute('color');
                const cm = c.hasAttribute('transform') ? mul(m, parseTransform(c.getAttribute('transform'))) : m;
                if (tag === 'g' || tag === 'a') { walk(c, cm, s); continue; }
