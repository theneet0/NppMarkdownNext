        /**
         * An equation for the .doc: el is replaced by a marker comment that
         * toMhtml() swaps, after serialization, for Word's conditional pair —
         * <!--[if gte msEquation 12]>OMML<![endif]--><![if !msEquation]>picture<![endif]>
         * (the second half is not DOM-safe, hence the marker).
         */
        _mathSlot(el, eq, fallback) {
