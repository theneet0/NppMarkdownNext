                    const vx = parseFloat(c.getAttribute('x')) || 0, vy = parseFloat(c.getAttribute('y')) || 0;
                    const vw = parseFloat(c.getAttribute('width')), vh = parseFloat(c.getAttribute('height'));
                    const nvb = String(c.getAttribute('viewBox') || '').trim().split(/[\s,]+/).map(Number);
                    const inner = mul(cm, viewMatrix(nvb.length === 4 ? nvb : null, vx, vy, vw || 0, vh || 0, c.getAttribute('preserveAspectRatio')));
                    const clip = c.getAttribute('overflow') !== 'visible' && vw > 0 && vh > 0;
                    if (clip) {
